# Copie este arquivo para ".env" antes de rodar `docker compose up`.
# Valores aqui são apenas para desenvolvimento local/self-host inicial — troque o Dashboard,
# a chave do JWT e o pepper das API Keys antes de expor isso na internet (ver DOCS/09-seguranca.md).

# Postgres
POSTGRES_USER=omniai
POSTGRES_PASSWORD=omniai_dev_password
POSTGRES_DB=omniai
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=omniai_replication_password
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICA_PORT=5433

# Redis
REDIS_PORT=6379

# Portas publicadas no host para cada serviço da aplicação
WEBHOOK_PORT=5100
CONSUMER_PORT=5200
APIGRAPHQL_PORT=5300
COCKPIT_PORT=8080

# Login do Dashboard (Cockpit) — usuário único, sem tabela de usuários (ver 09-seguranca.md)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin-dev-password

# Chave de assinatura do JWT do Dashboard — mínimo 32 caracteres
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-please-32chars

# Pepper usado no hash HMAC das API Keys de projeto (ver 09-seguranca.md)
API_KEY_PEPPER_SECRET=dev-only-pepper-change-me
