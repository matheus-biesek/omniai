{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Queue": {
    "StreamKey": "usage-events",
    "ConsumerGroup": "consumer-group",
    "ConsumerName": "consumer-1",
    "BatchSize": 50
  },
  "Retry": {
    "MaxAttempts": 5,
    "BaseDelaySeconds": 10
  },
  "Worker": {
    "PollIntervalMs": 500
  }
}
